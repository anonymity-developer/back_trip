# Copy to .env and replace example values. run-local.ps1 loads .env into its Tomcat process.
ENJOYTRIP_DB_URL=jdbc:mysql://localhost:3306/enjoytrip?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
ENJOYTRIP_DB_USER=enjoytrip
ENJOYTRIP_DB_PASSWORD=replace-me
ENJOYTRIP_ADMIN_ID=admin
ENJOYTRIP_ADMIN_EMAIL=admin@example.com
ENJOYTRIP_ADMIN_PASSWORD=replace-me
ENJOYTRIP_TOUR_API_KEY=
ENJOYTRIP_WEATHER_API_KEY=
ENJOYTRIP_DATA_GO_API_KEY=
ENJOYTRIP_UPLOAD_DIR=
